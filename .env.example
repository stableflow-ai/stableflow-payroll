# Copy to .env.local for local development.

# WalletConnect Cloud project ID for RainbowKit and the Tron WalletConnect adapter
# (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# HMAC-signed RPC proxy (host only, no scheme). Example: rpc.stableflow.example.com
VITE_RPC_PROXY_HOST=
VITE_RPC_SECRET_KEY=

# Backend API origin (no Vite proxy — the browser calls this host directly).
VITE_API_BASE_URL=https://test-api.stableflow.ai

# Max fractional digits for amount inputs (not on-chain token decimals).
VITE_AMOUNT_MAX_DECIMALS=6

# Google Sheets import and Google sign-in (GIS). Browser-visible; restrict by JS origins / referrers.
# Authorized JavaScript origins must include the Vite origin, e.g. http://localhost:5200
# Sign-in only needs VITE_GOOGLE_CLIENT_ID; Sheets import also needs API key and App ID.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Token picker "Popular on your network". Comma-separated blockchain:SYMBOL. Empty hides the section.
VITE_POPULAR_TOKENS=eth:USDT,sol:USDC,tron:USDT,arb:USDT
